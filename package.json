{
  "name": "personagraph",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cd frontend && WRANGLER_LOG_PATH=.wrangler/wrangler.log ../node_modules/.bin/vinext dev",
    "build": "cd frontend && WRANGLER_LOG_PATH=.wrangler/wrangler.log ../node_modules/.bin/vinext build",
    "start": "cd frontend && WRANGLER_LOG_PATH=.wrangler/wrangler.log ../node_modules/.bin/vinext start",
    "test": "npm run build && node --experimental-strip-types --test frontend/tests/*.test.mjs",
    "test:e2e": "playwright test --config frontend/config/playwright.config.mjs",
    "lint": "eslint --config frontend/config/eslint.config.mjs frontend",
    "db:generate": "drizzle-kit generate --config frontend/config/drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
