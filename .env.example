# Browser-visible API address used when the web image is built.
NEXT_PUBLIC_API_URL=http://localhost:8000
PERSONAGRAPH_API_URL=http://localhost:8000
# Set the same non-empty value in the API and web services outside local development.
AUTH_PROXY_SECRET=
LOCAL_DEVELOPMENT_OWNER=local-development-user

# PostgreSQL is the authoritative backend database. Change the password outside
# local development; Compose constructs DATABASE_URL for the API from these.
POSTGRES_DB=personagraph
POSTGRES_USER=personagraph
POSTGRES_PASSWORD=personagraph

# Create a key at https://cloud.cerebras.ai and keep the real value in `.env` only.
# Leave the key blank to use the zero-setup grounded synthesis mode.
CEREBRAS_API_KEY=
CEREBRAS_API_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# Local semantic retrieval (no API key; document text stays on this machine).
VECTOR_SEARCH_ENABLED=true
QDRANT_COLLECTION=personagraph_chunks
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
VECTOR_CANDIDATE_LIMIT=20
LEXICAL_CANDIDATE_LIMIT=20
VECTOR_TIMEOUT_SECONDS=5
EMBEDDING_TIMEOUT_SECONDS=30
