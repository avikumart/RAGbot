# Browser-visible API address used when the web image is built.
NEXT_PUBLIC_API_URL=http://localhost:8000
PERSONAGRAPH_API_URL=http://localhost:8000
# Set the same non-empty value in the API and web services outside local development.
AUTH_PROXY_SECRET=
LOCAL_DEVELOPMENT_OWNER=local-development-user

# PostgreSQL is the authoritative backend database. Change the password outside
# local development; Compose constructs DATABASE_URL for the API from these.
POSTGRES_DB=personagraph
POSTGRES_USER=personagraph
POSTGRES_PASSWORD=personagraph

# LLM Provider Configuration:
# Supported providers: 'cerebras', 'openai', 'gemini', 'anthropic', 'ollama', 'groq', or 'none' (local grounded synthesis)
LLM_PROVIDER=cerebras
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Provider-specific fallbacks (optional if LLM_API_KEY/LLM_MODEL/LLM_BASE_URL are set):
# Cerebras:
CEREBRAS_API_KEY=
CEREBRAS_API_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# OpenAI:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini:
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-1.5-flash

# Anthropic:
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Local Ollama (no API key required):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2


# Local semantic retrieval (no API key; document text stays on this machine).
VECTOR_SEARCH_ENABLED=true
QDRANT_COLLECTION=personagraph_chunks
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
VECTOR_CANDIDATE_LIMIT=20
LEXICAL_CANDIDATE_LIMIT=20
VECTOR_TIMEOUT_SECONDS=5
EMBEDDING_TIMEOUT_SECONDS=30
